{
  "name": "@ccr/host",
  "version": "0.1.0",
  "private": true,
  "description": "ccrd — the daemon that owns the Claude Code session and relays it to a phone.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "bin": {
    "ccrd": "./dist/daemon.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "start": "tsx src/daemon.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@ccr/core": "*",
    "@ccr/protocol": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  }
}
